        "antes": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Antes",
          "type": "string"
        },
        "campo": {
          "enum": [
            "taxa",
            "bonus.percentual",
            "bonus.valorFixo"
          ],
          "title": "Campo",
          "type": "string"
        },
        "depois": {
          "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
          "title": "Depois",
          "type": "string"
        },
        "idLocal": {
          "title": "Idlocal",
          "type": "string"
        }
      },
      "required": [
        "idLocal",
        "campo",
        "antes",
        "depois"
      ],
      "title": "AlteracaoParametro",
      "type": "object"
    },
