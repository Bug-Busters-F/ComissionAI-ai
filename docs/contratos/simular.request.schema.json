  "properties": {
    "assinaturaPrograma": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Assinatura (sha256) de `codigoAprovado`, devolvida por /gerar-programa, para detectar divergência entre o que foi aprovado e o que está sendo executado.",
      "title": "Assinaturaprograma"
    },
    "calibrar": {
      "default": false,
      "description": "IA-6: para cada cenário acima do orçamento, buscar uma alternativa de parâmetros verificada por reexecução. Exige `orcamento`.",
      "title": "Calibrar",
      "type": "boolean"
    },
    "cenarios": {
      "items": {
        "$ref": "#/$defs/Cenario"
      },
      "title": "Cenarios",
      "type": "array"
    },
    "codigoAprovado": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Código já gerado e validado por /gerar-programa (IA-2). Quando informado, a simulação executa ESSE código sem regerá-lo — a geração não é reinventada a cada clique em simular.",
      "title": "Codigoaprovado"
    },
    "competencia": {
      "pattern": "^\\d{4}-\\d{2}$",
      "title": "Competencia",
      "type": "string"
    },
    "contexto": {
      "$ref": "#/$defs/ContextoProposta"
    },
    "filtro": {
      "additionalProperties": true,
      "title": "Filtro",
      "type": "object"
    },
    "orcamento": {
