        "mensagem": {
          "title": "Mensagem",
          "type": "string"
        },
        "pergunta": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Pergunta"
        }
      },
      "required": [
        "codigo",
        "mensagem"
      ],
      "title": "Pendencia",
      "type": "object"
    },
    "ReferenciaBase": {
      "properties": {
        "chave": {
          "additionalProperties": true,
          "title": "Chave",
          "type": "object"
        },
        "consultadaEm": {
          "anyOf": [
            {
              "format": "date-time",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Consultadaem"
