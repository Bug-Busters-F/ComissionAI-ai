    "ContextoProposta": {
      "description": "Identifica de onde vem o pedido. Todos os ids são opacos para a IA.",
      "properties": {
        "campanhaId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campanhaid"
        },
        "execucaoId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Id da execução no backend; devolvido em cada explicação (IA-7).",
          "title": "Execucaoid"
        },
        "origem": {
          "default": "NOVA",
          "enum": [
            "NOVA",
            "VERSAO_EXISTENTE"
          ],
          "title": "Origem",
          "type": "string"
        },
        "revisao": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Revisao"
        },
        "substituiVersao": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Substituiversao"
        },
        "usuarioSolicitanteId": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Usuariosolicitanteid"
        },
        "versaoPrograma": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "description": "Versão do programa aprovada no backend (BACK-9); a IA devolve também a assinatura.",
          "title": "Versaoprograma"
        }
      },
      "title": "ContextoProposta",
      "type": "object"
    },
    "EvidenciaTool": {
      "description": "Registro rastreável de uma consulta/execução do agente.",
      "properties": {
        "argumentos": {
          "additionalProperties": true,
          "title": "Argumentos",
          "type": "object"
        },
        "blocosAfetados": {
          "items": {
            "type": "string"
          },
          "title": "Blocosafetados",
          "type": "array"
        },
        "duracaoMs": {
          "default": 0,
          "title": "Duracaoms",
          "type": "integer"
        },
        "ferramenta": {
          "title": "Ferramenta",
          "type": "string"
        },
        "passo": {
          "default": 0,
          "title": "Passo",
          "type": "integer"
        },
        "resumo": {
          "default": "",
          "title": "Resumo",
          "type": "string"
        },
        "status": {
          "enum": [
            "OK",
            "SEM_DADOS",
            "AMBIGUO",
            "FALHA"
          ],
          "title": "Status",
          "type": "string"
        }
      },
      "required": [
        "ferramenta",
        "status"
      ],
      "title": "EvidenciaTool",
      "type": "object"
    },
    "FaixaValor": {
      "properties": {
        "campo": {
          "const": "VENDA",
          "default": "VENDA",
          "title": "Campo",
          "type": "string"
        },
        "max": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Max"
        },
        "maxInclusivo": {
          "default": false,
          "title": "Maxinclusivo",
          "type": "boolean"
        },
        "min": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Min"
        },
        "minInclusivo": {
          "default": true,
          "title": "Mininclusivo",
          "type": "boolean"
        }
      },
      "title": "FaixaValor",
      "type": "object"
    },
    "Operacao": {
      "description": "O que fazer com a taxa. IA-2 só preenche TAXA_ABSOLUTA; os demais são do IA-5.",
      "properties": {
        "tipo": {
          "enum": [
            "TAXA_ABSOLUTA",
            "ADICIONAR_PP",
            "REDUZIR_PP",
            "AUMENTAR_PERCENTUAL",
            "REDUZIR_PERCENTUAL"
          ],
          "title": "Tipo",
          "type": "string"
        },
        "valor": {
          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            }
          ],
          "title": "Valor"
        }
      },
      "required": [
        "tipo",
        "valor"
      ],
      "title": "Operacao",
      "type": "object"
    },
    "Origem": {
      "description": "Trecho literal do pedido que originou um bloco.",
