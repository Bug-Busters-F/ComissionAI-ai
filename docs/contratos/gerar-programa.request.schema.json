          "anyOf": [
            {
              "type": "number"
            },
            {
              "pattern": "^(?!^[-+.]*$)[+-]?0*\\d*\\.?\\d*$",
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Taxabase"
        }
      },
      "required": [
        "fonte"
      ],
      "title": "ReferenciaBase",
      "type": "object"
    }
  },
  "description": "Gera e valida o programa da simulação ANTES da revisão técnica (IA-2), sem rodar sobre vendas reais.",
  "properties": {
    "contexto": {
      "$ref": "#/$defs/ContextoProposta"
    },
    "pedido": {
      "anyOf": [
        {
          "type": "string"
        },
        {
          "type": "null"
        }
      ],
      "default": null,
      "description": "Mesmo campo de SimularRequest.pedido: indica se há cálculo adicional (ex.: ajuste sobre a base) que exige código livre em vez do template fixo.",
      "title": "Pedido"
    },
    "propostas": {
      "items": {
        "$ref": "#/$defs/BlocoProposta"
      },
      "title": "Propostas",
      "type": "array"
    }
  },
  "required": [
    "propostas"
  ],
  "title": "GerarProgramaRequest",
  "type": "object"
}
