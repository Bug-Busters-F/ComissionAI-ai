        "fim": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Fim"
        },
        "inicio": {
          "anyOf": [
            {
              "type": "integer"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Inicio"
        },
        "trecho": {
          "title": "Trecho",
          "type": "string"
        }
      },
      "required": [
        "trecho"
      ],
      "title": "Origem",
      "type": "object"
    },
    "Pendencia": {
      "properties": {
        "campo": {
          "anyOf": [
            {
              "type": "string"
            },
            {
              "type": "null"
            }
          ],
          "default": null,
          "title": "Campo"
        },
        "codigo": {
          "$ref": "#/$defs/CodigoPendencia"
