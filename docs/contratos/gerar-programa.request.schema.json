    "CodigoPendencia": {
      "description": "Catálogo fechado de pendências.",
      "enum": [
        "CAMPO_AUSENTE",
        "AMBIGUIDADE_CARGO",
        "AMBIGUIDADE_PUBLICO",
        "CADASTRO_INEXISTENTE",
