        "CRITERIO_NAO_SUPORTADO",
        "TRECHO_INCOMPLETO",
        "VIGENCIA_INCOMPATIVEL",
        "BASE_AUSENTE",
        "CONFLITO_REGRA",
        "TOOL_FALHA",
        "LIMITE_AGENTE_ATINGIDO",
        "TAXA_INVALIDA",
        "SIMULACAO_NAO_VALIDADA",
        "NAO_SUPORTADO_NA_APURACAO"
