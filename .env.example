# ==============================================================================
# Configurações do Serviço de IA (FastAPI) - Dom Rock / Bug Busters
# ==============================================================================

# --- Provedor de LLM ---
# Opções suportadas: gemini | openai | anthropic | groq
LLM_PROVIDER=gemini

# SDK correspondente para build Docker (google-genai | openai | anthropic | groq)
LLM_SDK=google-genai

# Chave de API do provedor selecionado
LLM_API_KEY=sua_chave_aqui

# Modelo a ser utilizado (deixe em branco para usar o padrão do provedor)
# Padrões:
#   gemini:    gemini-3.6-flash
#   openai:    gpt-4o-mini
#   anthropic: claude-3-5-haiku-20241022
#   groq:      openai/gpt-oss-20b
LLM_MODEL=gemini-3.6-flash

# Parâmetros de Inferência
LLM_TEMPERATURE=0.0
LLM_TIMEOUT_SECONDS=30
LLM_MAX_OUTPUT_TOKENS=1024

# --- Configurações do Servidor API ---
APP_HOST=0.0.0.0
APP_PORT=8000
APP_RELOAD=false

# --- Backend (Spring) consultado pelas tools do agente ---
# Rodando fora do Docker: http://localhost:8080 | Dentro do Docker: http://host.docker.internal:8080
BACKEND_BASE_URL=http://localhost:8080
TOOL_TIMEOUT_SECONDS=5

# --- Agente (limites por requisição) ---
AGENT_MAX_STEPS=6
AGENT_MAX_TOOL_CALLS=8
AGENT_MAX_DURATION_SECONDS=45
AGENT_MAX_CODE_EXECUTIONS=5

# --- Simulação (sandbox de código gerado) ---
SIM_MAX_SECONDS=10
SIM_MAX_MEMORY_MB=256
SIM_MAX_OUTPUT_KB=512
SIM_MAX_REGISTROS=50000
SIM_MAX_CENARIOS=5
SIM_MAX_CODE_LINES=150
SIM_MAX_CODE_BYTES=8192
